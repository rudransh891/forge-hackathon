# Deployment: static frontend, API somewhere else
#
# Vercel serves files only. The FastAPI backend has to run on a host that keeps a
# process alive and a writable disk (Render, Railway, Fly, a VPS). Set the values
# below after the API is reachable over HTTPS.

# --- Frontend (Vercel -> Project -> Settings -> Environment Variables) ---------

# Origin of the API, no trailing slash and no /api suffix, because the FastAPI
# routes sit at the root. Everything, including photos, is fetched from here.
VITE_API_BASE=https://fixitbharat-api.onrender.com

# Firebase web config, copied from the Firebase console (public identifiers).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Backend (Render -> Environment) ------------------------------------------

# Accept the deployed site. Comma separated exact origins.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5174

# Preview deployments get a new hostname on every push. This regex accepts the
# whole domain; remove it if you only trust one origin.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Add the deployed site to Firebase -> Authentication -> Settings -> Authorized
# domains, or Google sign-in fails with auth/unauthorized-domain.
