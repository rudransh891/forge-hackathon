# Copy to Backend/.env and fill in. Backend/.env is gitignored.

# --- Firebase ---------------------------------------------------------------
# Same Web API key as VITE_FIREBASE_API_KEY in the root .env. The backend uses
# it to verify ID tokens through the Identity Toolkit REST API.
FIREBASE_API_KEY=

# --- Vision model -----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_FALLBACK_MODELS=

# --- Database ---------------------------------------------------------------
DATABASE_URL=

# --- Duplicate detection ----------------------------------------------------
DUPLICATE_RADIUS_M=50

# --- Geocoding --------------------------------------------------------------
NOMINATIM_CONTACT=

# --- Complaint routing (email goes to this inbox, never to a department) ----
ROUTING_TEST_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Escalation scheduler ---------------------------------------------------
ESCALATION_INTERVAL_MINUTES=5
ESCALATION_LIVE=false

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API directly. The vite proxy makes
# this unnecessary in development.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
